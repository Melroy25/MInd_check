# Grok (xAI) API Keys (4 keys with automatic token limit & rate limit rotation)
EXPO_PUBLIC_GROK_API_KEY_1=
EXPO_PUBLIC_GROK_API_KEY_2=
EXPO_PUBLIC_GROK_API_KEY_3=
EXPO_PUBLIC_GROK_API_KEY_4=
EXPO_PUBLIC_GROK_MODEL=grok-2-latest

# Supabase Real Backend Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Keys (Add 1 to 5 keys for automatic failover & load balancing)
EXPO_PUBLIC_GEMINI_API_KEY_1=
EXPO_PUBLIC_GEMINI_API_KEY_2=
EXPO_PUBLIC_GEMINI_API_KEY_3=
EXPO_PUBLIC_GEMINI_API_KEY_4=
EXPO_PUBLIC_GEMINI_API_KEY_5=

# Gemini Active Model
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite
