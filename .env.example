# Copy this file to .env.local and populate with your production credentials:
# cp .env.example .env.local

# ─── GROQ 4-KEY ROTATION POOL (Whisper STT & Fast Clinical LLM) ──────────────
EXPO_PUBLIC_GROK_API_KEY_1=gsk_your_key_1_here
EXPO_PUBLIC_GROK_API_KEY_2=gsk_your_key_2_here
EXPO_PUBLIC_GROK_API_KEY_3=gsk_your_key_3_here
EXPO_PUBLIC_GROK_API_KEY_4=gsk_your_key_4_here

# Groq Active Models
EXPO_PUBLIC_GROK_MODEL=openai/gpt-oss-120b
