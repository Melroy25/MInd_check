{
  "expo": {
    "name": "medivault",
    "slug": "medivault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.melroy10.medivault",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedFlow to access your camera to scan medical QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f1f3ebb5-6231-4bde-b742-4c58b7132077"
      }
    }
  }
}
